{
  "name": "mystery-road-awe-2026",
  "version": "1.0.0",
  "description": "Project ReMotion investigation portal for Advanced Web Engineering: a vanilla JavaScript application using native ES modules.",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-checker": "^0.14.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
